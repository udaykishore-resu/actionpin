{
  "manifest_version": 3,
  "name": "ActionPin — SHA-pin lens for GitHub Actions",
  "short_name": "ActionPin",
  "version": "0.2.1",
  "description": "Shows whether each GitHub Actions `uses:` line is pinned to a commit SHA, resolves tags to SHAs, and flags wrong version comments.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ActionPin",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "lib/core.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
